# Front Assur'Trans — configuration.
#
# Une seule variable, et c'est une adresse publique : le front ne detient aucun secret.
# Le prefixe ASSURTRANS_ est impose par vite.config.ts, qui refuse d'exposer autre chose.
#
# Copier vers web/.env.local pour un reglage personnel.

ASSURTRANS_API=http://localhost:3001
