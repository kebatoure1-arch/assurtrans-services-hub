# Dépendances
node_modules/
.pnp
.pnp.js

# Build
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo
*.local

# ---------------------------------------------------------------------------
# Secrets — rien de ce qui suit ne doit atteindre le dépôt.
# Seuls les fichiers `.env.example` sont versionnés, et ils ne contiennent
# aucune valeur : uniquement des noms de variables et leur documentation.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
!server/.env.example
*.pem
*.key
*.p12
*.pfx
# Ancre a la racine : sans le « / » initial, ce motif exclurait aussi tout dossier
# nomme « secrets » dans le code source — ce qui est arrive a
# server/src/infra/secrets/, reste absent du depot jusqu'au 2026-09-07.
/secrets/
.vault-token

# Éditeurs
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.donnees-locales/
