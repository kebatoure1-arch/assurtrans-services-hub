# ============================================================================
# Assur'Trans© — Variables d'environnement du SERVEUR
# ============================================================================
#
# Ces variables ne sont jamais lues par le front et ne portent jamais le
# préfixe `VITE_`. `EnvSecretProvider` refuse explicitement tout nom préfixé
# `VITE_`, y compris comme valeur de repli.
#
# En production, ces valeurs ne viennent PAS d'un fichier : elles sont injectées
# dans l'environnement du processus au démarrage par KMS ou Vault. Le fichier
# `.env` local est réservé au développement.
#
# Aucune valeur de repli n'existe. Une variable manquante empêche le démarrage.
#
# ============================================================================


# ============================================================================
# Wave Business
# ============================================================================

# Clé API du portefeuille Wave Business.
# Une clé par portefeuille. Format : wave_sn_prod_...
# Source : Business Portal Wave. Rotation : voir docs/RUNBOOK.md §1.
WAVE_API_KEY=

WAVE_BASE_URL=https://api.wave.com

# Secret de vérification des signatures de webhook Wave.
WAVE_WEBHOOK_SECRET=

# Nom de l'en-tête portant la signature des webhooks Wave.
# A confirmer sur la documentation Wave. Vide => toute verification est refusee
# plutot que de valider n'importe quoi.
WAVE_WEBHOOK_SIGNATURE_HEADER=

# Tolérance d'horodatage des webhooks, en secondes. Protection anti-rejeu.
# Ne pas élargir pour debloquer une reception : verifier NTP d'abord.
WEBHOOK_TOLERANCE_SECONDES=300

# Nom du champ libre du payload de payout qui porte la référence d'imputation.
# ⛔ À obtenir de TotalEnergies + documentation Wave (§14, paramètre 2).
# Obligatoire dès que SETTLEMENT_CHANNEL vaut B2B ou MOBILE.
WAVE_PAYOUT_REFERENCE_FIELD=


# ============================================================================
# Canal de règlement
# ============================================================================
#
# DRY_RUN : écrit l'intention en base, n'appelle pas Wave. Aucun mouvement.
# B2B     : POST /v1/b2b/payout — exige le B2B ID de TotalEnergies.
# MOBILE  : POST /v1/payout     — exige le numéro Wave désigné par TotalEnergies.
#
# ⛔ Rester en DRY_RUN tant que les paramètres 1, 2, 3 et 5 du §14 ne sont pas
#    obtenus. Voir docs/ADR-002-canal-reglement.md.

SETTLEMENT_CHANNEL=DRY_RUN


# ============================================================================
# Canal d'encaissement — paiement des chauffeurs
# ============================================================================
#
# DRY_RUN       : session de paiement simulée, aucun appel réseau.
# WAVE_CHECKOUT : POST /v1/checkout/sessions.
#
# L'API Checkout ENCAISSE. Elle ne règle pas TotalEnergies — c'est SETTLEMENT_CHANNEL
# qui s'en charge, et les deux ne se remplacent pas.

COLLECTION_CHANNEL=DRY_RUN

# Nom du champ de la réponse Checkout portant l'URL de paiement du chauffeur.
# A confirmer sur la documentation Wave. Obligatoire si COLLECTION_CHANNEL=WAVE_CHECKOUT.
WAVE_CHECKOUT_LAUNCH_URL_FIELD=


# ============================================================================
# Bons carburant
# ============================================================================
#
# Durée de validité d'un bon, en heures. Un bon qui ne périme jamais redevient un
# solde — voir ADR-003, règle 3.

VALIDITE_BON_HEURES=24

# Bornes du montant d'un bon, en francs CFA entiers.
# Un chauffeur ne demande ni 1 franc ni 100 millions.
MONTANT_BON_MIN_XOF=1000
MONTANT_BON_MAX_XOF=200000


# ============================================================================
# Plafonds serveur
# ============================================================================
#
# Entiers de francs CFA, sans séparateur ni décimale.
# Non modifiables par l'interface. Un dépassement est un refus, pas un
# avertissement.
# ⛔ À calibrer sur les plafonds réels du portefeuille (§14, paramètre 6).

# Montant maximal d'un règlement unitaire
PLAFOND_UNITAIRE_XOF=

# Cumul maximal réglé sur une journée civile
PLAFOND_QUOTIDIEN_XOF=


# ============================================================================
# Base de données
# ============================================================================

DATABASE_URL=


# ============================================================================
# Entite exploitee
# ============================================================================
#
# Identifiant de l'entite Assur'Trans de ce deploiement. Vide au premier
# demarrage : l'entite se cree ensuite via POST /api/admin/entities, et son
# identifiant se reporte ici.

ENTITY_ID=

# Fenetre d'observation de la consommation, en jours. Sert a mesurer le rythme
# pour projeter la date d'atteinte du seuil de blocage.
FENETRE_CONSOMMATION_JOURS=30


# ============================================================================
# Serveur HTTP
# ============================================================================

PORT=3000

# Origines autorisees pour le front. Liste explicite, separee par des virgules.
# Vide = aucune requete inter-origine acceptee.
ORIGINES_AUTORISEES=http://localhost:5174


# ============================================================================
# Authentification par telephone
# ============================================================================
#
# Passerelle retenue pour les codes OTP. LOG est réservé au développement local.
OTP_SMS_PROVIDER=AFRICAS_TALKING

OTP_DUREE_SECONDES=300
OTP_MAX_TENTATIVES=5
OTP_MAX_DEMANDES_PAR_HEURE=3
SESSION_DUREE_HEURES=12

# Renvoie le code dans la reponse HTTP. Demonstration uniquement.
# ⛔ Doit rester absent ou false en production.
OTP_ECHO=


# ============================================================================
# Lecture des événements de paiement
# ============================================================================
#
# A confirmer sur la documentation Wave. Tant que ces trois valeurs sont vides,
# la lecture des evenements refuse de s'executer : un mappeur qui devine
# produirait des bons sur des evenements mal compris, donc du carburant offert.

# Type d'evenement signalant un paiement abouti
CHECKOUT_EVENT_TYPE=

# Chemin, separe par des points, du champ portant NOTRE reference
CHECKOUT_REFERENCE_PATH=

# Chemin du champ portant le montant effectivement paye
CHECKOUT_AMOUNT_PATH=


# ============================================================================
# Secrets migrés depuis le front
# ============================================================================
#
# Voir docs/SECRETS.md. Chacun de ces secrets était auparavant exposé dans le
# bundle client sous un nom préfixé VITE_.

# Signature HMAC des QR codes carburant.
# Générer : openssl rand -hex 32
QR_SIGNATURE_SECRET=

# Cle precedente, acceptee en verification seulement, le temps d'une rotation.
# La retirer avant l'expiration des bons en circulation les invaliderait.
QR_SIGNATURE_SECRET_PRECEDENT=

# Envoi d'e-mails
RESEND_API_KEY=

# SMS
AFRICAS_TALKING_BASE_URL=https://api.africastalking.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=
