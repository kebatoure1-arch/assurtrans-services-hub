# ============================================================================
# Assur'Trans© — Variables d'environnement du SERVEUR
# ============================================================================
#
# Ces variables ne sont jamais lues par le front et ne portent jamais le
# préfixe `VITE_`. `EnvSecretProvider` refuse explicitement tout nom préfixé
# `VITE_`, y compris comme valeur de repli.
#
# En production, ces valeurs ne viennent PAS d'un fichier : elles sont injectées
# dans l'environnement du processus au démarrage par KMS ou Vault. Le fichier
# `.env` local est réservé au développement.
#
# Aucune valeur de repli n'existe. Une variable manquante empêche le démarrage.
#
# ============================================================================


# ============================================================================
# Wave Business
# ============================================================================

# Clé API du portefeuille Wave Business.
# Une clé par portefeuille. Format : wave_sn_prod_...
# Source : Business Portal Wave. Rotation : voir docs/RUNBOOK.md §1.
WAVE_API_KEY=

WAVE_BASE_URL=https://api.wave.com

# Secret de vérification des signatures de webhook Wave.
WAVE_WEBHOOK_SECRET=

# Nom du champ libre du payload de payout qui porte la référence d'imputation.
# ⛔ À obtenir de TotalEnergies + documentation Wave (§14, paramètre 2).
# Obligatoire dès que SETTLEMENT_CHANNEL vaut B2B ou MOBILE.
WAVE_PAYOUT_REFERENCE_FIELD=


# ============================================================================
# Canal de règlement
# ============================================================================
#
# DRY_RUN : écrit l'intention en base, n'appelle pas Wave. Aucun mouvement.
# B2B     : POST /v1/b2b/payout — exige le B2B ID de TotalEnergies.
# MOBILE  : POST /v1/payout     — exige le numéro Wave désigné par TotalEnergies.
#
# ⛔ Rester en DRY_RUN tant que les paramètres 1, 2, 3 et 5 du §14 ne sont pas
#    obtenus. Voir docs/ADR-002-canal-reglement.md.

SETTLEMENT_CHANNEL=DRY_RUN


# ============================================================================
# Plafonds serveur
# ============================================================================
#
# Entiers de francs CFA, sans séparateur ni décimale.
# Non modifiables par l'interface. Un dépassement est un refus, pas un
# avertissement.
# ⛔ À calibrer sur les plafonds réels du portefeuille (§14, paramètre 6).

# Montant maximal d'un règlement unitaire
PLAFOND_UNITAIRE_XOF=

# Cumul maximal réglé sur une journée civile
PLAFOND_QUOTIDIEN_XOF=


# ============================================================================
# Base de données
# ============================================================================

DATABASE_URL=


# ============================================================================
# Secrets migrés depuis le front
# ============================================================================
#
# Voir docs/SECRETS.md. Chacun de ces secrets était auparavant exposé dans le
# bundle client sous un nom préfixé VITE_.

# Signature HMAC des QR codes carburant.
# Générer : openssl rand -hex 32
QR_SIGNATURE_SECRET=

# TPE
TPE_API_KEY=
TPE_API_SECRET=
TPE_MERCHANT_ID=
TPE_WEBHOOK_SECRET=

# Envoi d'e-mails
RESEND_API_KEY=

# SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
