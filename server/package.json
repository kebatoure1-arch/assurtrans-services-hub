{
  "name": "assurtrans-settlement-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Orchestration du règlement de la carte carburant post-payée TotalEnergies depuis un portefeuille Wave Business. Mode DRY_RUN tant que les paramètres §14 ne sont pas obtenus.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json --watch",
    "build": "tsc -p tsconfig.build.json",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "node scripts/migrate.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:local": "node scripts/base-locale.mjs demarrer",
    "db:local:effacer": "node scripts/base-locale.mjs effacer",
    "amorcer": "node scripts/amorcer.mjs",
    "jeu-demo": "node scripts/jeu-demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "~5.7.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.3",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  }
}
