# ============================================================================
# Assur'Trans© — Variables d'environnement du FRONT
# ============================================================================
#
# ⚠️  RÈGLE ABSOLUE
#
# Vite inline toute variable `VITE_*` dans le JavaScript servi aux utilisateurs.
# Une valeur placée ici est PUBLIQUE : n'importe qui peut l'extraire du bundle
# en ouvrant les outils de développement du navigateur.
#
# Ce fichier ne contient donc QUE de la configuration publique.
#
# Aucune clé d'API, aucun secret HMAC, aucun jeton, aucun mot de passe.
# Ces valeurs vivent côté serveur : voir `server/.env.example` et
# `server/docs/SECRETS.md`.
#
# Un scan automatisé (`cd server && npm run scan:secrets`) échoue si un nom de
# variable `VITE_*` désigne un secret.
#
# Copier ce fichier vers `.env.local` (ignoré par git) et renseigner les valeurs.
#
# ============================================================================


# ============================================================================
# Backend Assur'Trans
# ============================================================================

# URL du serveur de règlement et des opérations sensibles.
# C'est lui qui détient les clés d'API et signe les QR codes.
ASSURTRANS_API=http://localhost:3000


# ============================================================================
# QR Code — configuration publique
# ============================================================================
#
# Le secret de signature HMAC ne figure plus ici. Un secret de signature publié
# ne signe plus rien : n'importe qui pourrait forger un QR valide.
# La signature et la vérification se font côté serveur.

# Durée de validité d'un QR, en heures
VITE_QR_EXPIRATION_HOURS=48


# ============================================================================
# Notifications — configuration publique
# ============================================================================
#
# Les jetons Twilio et Africa's Talking ne figurent plus ici.

# Adresse d'expédition affichée (doit être vérifiée chez le prestataire)
VITE_RESEND_FROM_EMAIL=noreply@assurtrans.com

# Numéro d'expédition SMS affiché
VITE_TWILIO_PHONE_NUMBER=


# ============================================================================
# Application
# ============================================================================

# development | staging | production
VITE_APP_ENV=development

VITE_APP_NAME=Assur'Trans©

VITE_APP_URL=http://localhost:5173

VITE_DEBUG=false


# ============================================================================
# Indicateurs de fonctionnalité
# ============================================================================

VITE_ENABLE_OFFLINE=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true


# ============================================================================
# Variables retirées de ce fichier
# ============================================================================
#
# Les variables ci-dessous désignaient des secrets et étaient publiées dans le
# bundle client. Leur remplacement côté serveur est décrit dans
# `server/docs/SECRETS.md`, section « Table de correspondance ».
#
#   VITE_TPE_API_KEY              → supprimé  (intégration OLA ENERGY retirée)
#   VITE_TPE_API_SECRET           → supprimé
#   VITE_TPE_MERCHANT_ID          → supprimé
#   VITE_TPE_WEBHOOK_SECRET       → supprimé
#   VITE_QR_SIGNATURE_SECRET      → QR_SIGNATURE_SECRET    (serveur)
#   VITE_RESEND_API_KEY           → RESEND_API_KEY         (serveur)
#   VITE_TWILIO_ACCOUNT_SID       → TWILIO_ACCOUNT_SID     (serveur)
#   VITE_TWILIO_AUTH_TOKEN        → TWILIO_AUTH_TOKEN      (serveur)
#   VITE_AFRICAS_TALKING_API_KEY  → AFRICAS_TALKING_API_KEY(serveur)
#   VITE_ORANGE_MONEY_API_KEY     → retiré  (voir SECRETS.md)
#   VITE_ORANGE_MONEY_API_SECRET  → retiré
#   VITE_WAVE_API_KEY             → WAVE_API_KEY           (serveur, KMS/Vault)
#   VITE_WAVE_API_SECRET          → retiré  (Wave n'utilise pas de secret pair)
#   VITE_FREE_MONEY_API_KEY       → retiré
#   VITE_FREE_MONEY_API_SECRET    → retiré
#
# ============================================================================
